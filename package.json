{
  "name": "continuum",
  "private": true,
  "type": "module",
  "description": "Continuum 无限遛弯 · 道行之而成。",
  "scripts": {
    "check": "node tools/physics_check.mjs 60",
    "check:long": "node tools/physics_check.mjs 300",
    "check:road": "node tools/road_check.mjs 16",
    "check:survey": "node tools/survey_check.mjs",
    "check:worlds": "node tools/world_check.mjs 130",
    "check:cavern": "node tools/world_cavern_check.mjs",
    "check:grass": "node tools/grass_check.mjs",
    "check:horizon": "node tools/horizon_check.mjs",
    "check:fold": "node tools/fold_check.mjs",
    "check:presentation": "node tools/presentation_check.mjs",
    "check:director": "node tools/director_check.mjs 180",
    "check:ui": "node tools/ui_check.mjs",
    "check:photo": "node tools/photo_check.mjs",
    "check:input": "node tools/input_check.mjs",
    "check:space": "node tools/world_space_check.mjs",
    "look": "node tools/look.mjs",
    "check:perf": "node tools/perf_check.mjs --check tools/look/perf-baseline.json",
    "check:cold": "node tools/cold_check.mjs --check tools/look/cold-baseline.json",
    "check:soak": "node tools/perf_check.mjs --soak",
    "check:steps": "node tools/perf_check.mjs --steps",
    "check:look":"node tools/look.mjs --styles real,paint,ink,cel,print,pixel,block --check tools/look/targets.json --against tools/look/baseline.json",
    "check:ink": "node tools/look.mjs --styles ink --check tools/look/targets-ink.json",
    "shots": "node tools/shot.mjs",
    "stamp": "node tools/stamp.mjs",
    "test": "node tools/game_check.mjs"
  }
}
